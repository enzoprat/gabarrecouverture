---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ChantierCard from "../components/ChantierCard.astro";
import CallCta from "../components/CallCta.astro";
import Icon from "../components/Icon.astro";
import { REALISATIONS } from "../data/realisations";
import { SERVICES } from "../site.config";

const breadcrumb = [{ label: "Réalisations" }];

const title = "Réalisations, chantiers de toiture à Montauban | Gabarre";
const description =
  "Chantiers de couverture, charpente et zinguerie réalisés à Montauban et en Tarn-et-Garonne, en photos, avec la commune et le matériau posé.";
---

<BaseLayout
  title={title}
  description={description}
  canonical="/realisations"
  breadcrumb={breadcrumb}
>
  <PageHero
    eyebrow="Réalisations"
    title="Chantiers réalisés à Montauban et alentours"
    lead="Chaque chantier est présenté avec la prestation réalisée, la commune et le matériau posé. Pas de photo de catalogue, uniquement des toitures sur lesquelles je suis intervenu."
    breadcrumb={breadcrumb}
  />

  <section class="bg-white py-16 md:py-24">
    <div class="container-site">
      <SectionHeading
        eyebrow="En images"
        title="Trois chantiers récents"
        id="chantiers"
      />

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          REALISATIONS.map((item, index) => (
            <ChantierCard item={item} eager={index === 0} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="container-site">
      <SectionHeading
        eyebrow="Prestations"
        title="Le type de chantiers que je traite"
        id="prestations"
        intro="Réfection complète, reprise ponctuelle, évacuation des eaux ou entretien : la nature du chantier change complètement le déroulé et la durée."
      />
      <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          SERVICES.map((service) => (
            <li>
              <a
                href={service.href}
                class="flex h-full flex-col rounded-[10px] border border-line bg-white p-6 transition-colors duration-150 hover:border-tuile-600"
              >
                <h3 class="h3-site">{service.cardTitle}</h3>
                <p class="mt-2 flex-1 text-[15px] leading-[1.6] text-ink-600">
                  {service.cardText}
                </p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-[15px] font-semibold text-tuile-600">
                  Voir la prestation
                  <Icon name="arrow-right" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CallCta
    title="Un chantier similaire chez vous"
    text="Décrivez votre toiture par téléphone. Je vous dis ce qui se rapproche le plus de votre situation et ce que cela implique."
  />
</BaseLayout>
