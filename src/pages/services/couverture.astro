---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import type { FaqItem } from "../../components/Faq.astro";
import image from "../../assets/service-couverture.webp";

const includes = [
  {
    label: "Dépose de l'ancienne couverture",
    text: "Retrait des tuiles, des liteaux et de l'ancien écran s'il existe, tri sur place et évacuation en benne. C'est cette étape qui révèle l'état réel du support, souvent différent de ce qu'on voit depuis le sol.",
  },
  {
    label: "Contrôle et reprise du liteaunage",
    text: "Remplacement des liteaux fendus, humides ou attaqués par les insectes, puis repositionnement au pureau qui correspond exactement au modèle de tuile retenu.",
  },
  {
    label: "Pose d'un écran sous-toiture",
    text: "Film hautement perméable à la vapeur agrafé sur les chevrons, avec contre-lattage pour ménager une lame d'air. C'est la deuxième barrière contre les entrées d'eau et la neige poudreuse.",
  },
  {
    label: "Pose de la couverture",
    text: "Tuile canal, tuile mécanique à emboîtement ou ardoise selon la pente et le bâti. Les rangs exposés au vent, en rive, en égout et en faîtage, sont fixés mécaniquement.",
  },
  {
    label: "Traitement du faîtage",
    text: "Faîtage à sec sur closoir ventilé, ou scellement au mortier bâtard quand le contexte l'impose. Le closoir évite les faîtages qui se descellent au bout de quelques hivers.",
  },
  {
    label: "Rives, égouts et arêtiers",
    text: "Tuiles de rive, about de rive, chanlatte et bavette d'égout, pour que l'eau parte dans la gouttière et non derrière la planche de rive.",
  },
  {
    label: "Points singuliers",
    text: "Noues, solins de cheminée, sorties de ventilation, châssis de toit et tuiles à douille. Ce sont ces zones qui fuient en premier, jamais le milieu du pan.",
  },
  {
    label: "Nettoyage et évacuation",
    text: "Dépose des protections, ramassage des chutes et des clous, évacuation des gravats en déchèterie professionnelle. Le terrain est rendu propre.",
  },
];

const steps = [
  {
    num: "01",
    title: "Diagnostic sur place",
    text: "Montée sur toiture, contrôle du support depuis les combles, relevé des surfaces en mètres carrés et des linéaires de rive, de faîtage et de noue. Vous recevez les photos des désordres constatés.",
  },
  {
    num: "02",
    title: "Devis et choix des matériaux",
    text: "Modèle et teinte de tuile, type d'écran, accessoires : tout est arrêté avant le démarrage. On vérifie ensemble ce que le plan local d'urbanisme impose sur votre secteur.",
  },
  {
    num: "03",
    title: "Installation du chantier",
    text: "Échafaudage ou protections périphériques selon la configuration, benne à gravats, bâchage des abords et des plantations, sécurisation des accès pour les occupants.",
  },
  {
    num: "04",
    title: "Dépose et pose par pans",
    text: "On ne découvre jamais une grande surface d'un coup. Le travail avance pan par pan et la toiture est refermée chaque soir, ce qui met le logement à l'abri d'un orage nocturne.",
  },
  {
    num: "05",
    title: "Contrôle et réception",
    text: "Vérification de tous les points singuliers, contrôle des recouvrements, nettoyage complet, puis remise du procès-verbal de réception et de l'attestation de garantie décennale.",
  },
];

const materials = [
  {
    name: "Tuile canal terre cuite",
    text: "La couverture traditionnelle du Sud-Ouest, adaptée aux faibles pentes. Se pose en version à emboîtement pour le rang de courant, avec une canal de couvert pour conserver l'aspect ancien.",
  },
  {
    name: "Tuile mécanique à emboîtement",
    text: "Grand moule ou petit moule, pose plus rapide et bonne tenue au vent grâce aux emboîtements latéraux. Large choix de teintes, du rouge naturel au brun vieilli.",
  },
  {
    name: "Ardoise naturelle",
    text: "Pose au crochet ou au clou sur liteaux ou voliges. Réservée aux pentes franches, elle offre une durée de vie très longue et une finition nette sur les bâtis anciens.",
  },
  {
    name: "Écran sous-toiture HPV",
    text: "Hautement perméable à la vapeur, il laisse respirer la charpente tout en arrêtant l'eau. Fortement recommandé dès qu'un isolant est posé sous rampant.",
  },
  {
    name: "Closoir ventilé de faîtage",
    text: "Bande souple posée sous les tuiles faîtières. Elle assure la ventilation en partie haute de la couverture et supprime le mortier qui se fissure avec les mouvements de charpente.",
  },
  {
    name: "Accessoires terre cuite",
    text: "Tuiles à douille pour les sorties, chatières de ventilation, tuiles de rive, abouts d'arêtier. Choisis dans le même modèle et la même teinte que le courant, pour éviter l'effet rapiécé.",
  },
];


const facteurs = [
  "La pente et la hauteur de la toiture, qui déterminent le besoin d'échafaudage et la vitesse de travail.",
  "L'état du support une fois découvert : un liteaunage à refaire intégralement double le volume de travail.",
  "Le modèle de tuile retenu, une canal vieillie ne se pose ni au même rythme ni avec les mêmes accessoires qu'une mécanique.",
  "Le nombre de points singuliers à traiter : cheminées, châssis de toit, lucarnes, noues.",
  "L'accès au chantier et la place disponible pour la benne et le monte-matériaux.",
];

const faq: FaqItem[] = [
  {
    q: "Réfection complète ou simple remaniage, comment choisir ?",
    a: "Le remaniage consiste à déposer les tuiles, contrôler le support, remplacer les éléments cassés et tout reposer. Il se justifie quand les tuiles sont encore saines et que le désordre vient du support ou d'un tassement. Dès que la terre cuite est gélive, feuilletée ou que plus d'un quart des tuiles est à changer, la réfection complète revient moins cher au bout du compte, puisque la main d'œuvre de dépose et de repose est la même dans les deux cas.",
  },
  {
    q: "Peut-on changer de modèle de tuile sur une toiture existante ?",
    a: "Techniquement oui, à condition que la pente et la charpente le permettent. Une tuile mécanique est plus lourde qu'une canal ancienne, il faut vérifier la section des chevrons et l'entraxe. Administrativement, un changement de modèle ou de teinte modifie l'aspect extérieur et suppose une déclaration préalable en mairie. Sur certains secteurs de Montauban, le plan local d'urbanisme impose une teinte et un type précis. On vérifie ce point avant d'engager quoi que ce soit.",
  },
  {
    q: "Combien de temps dure une couverture en tuile terre cuite ?",
    a: "Une tuile terre cuite de bonne qualité, posée dans les règles et entretenue, tient couramment plusieurs décennies. Ce ne sont pas les tuiles qui lâchent en premier, mais les points singuliers : solins de cheminée, faîtages scellés au mortier, noues en zinc. Un contrôle visuel tous les deux à trois ans et un démoussage quand la mousse s'installe suffisent à repousser très loin l'échéance d'une réfection.",
  },
];
---

<ServiceLayout
  slug="couverture"
  metaTitle="Couvreur à Montauban (82), rénovation de toiture | Gabarre"
  metaDescription="Réfection de toiture, remaniage et remplacement de tuiles à Montauban et en Tarn-et-Garonne. Tuile canal, mécanique ou ardoise. Devis gratuit, décennale."
  eyebrow="Couverture"
  h1="Couverture et rénovation de toiture à Montauban"
  lead="Réfection complète avec dépose de l'ancienne couverture, remaniage, remplacement de tuiles cassées et pose d'écran sous-toiture. Sur maison ancienne en tuile canal comme sur pavillon en tuile mécanique."
  serviceName="La couverture"
  serviceType="Rénovation et pose de couverture de toiture"
  image={image}
  imageAlt="Pose de tuiles canal sur un pan de toiture avec écran sous-toiture apparent"
  includesTitle="Ce que comprend une réfection de toiture"
  includesIntro="Une couverture ne se résume pas à la pose des tuiles. L'essentiel du travail se joue sur le support et sur les points singuliers, là où l'eau cherche à entrer."
  includes={includes}
  stepsTitle="Comment se déroule un chantier de couverture"
  steps={steps}
  materialsTitle="Matériaux et options"
  materialsIntro="Le choix se fait selon la pente, le bâti existant et les règles d'urbanisme de votre commune. Tout est nommé précisément au devis, modèle et teinte compris."
  materials={materials}
  visiteIntro="Une toiture ne se juge pas depuis le sol. La montée sur le toit permet de contrôler le support sous les tuiles, l'état des points singuliers et la charpente, avant d'annoncer quoi que ce soit."
  facteurs={facteurs}
  faq={faq}
>
  <section class="bg-white py-16 md:py-24">
    <div class="container-site">
      <div class="prose-site max-w-3xl">
        <h2>Couverture, charpente et zinguerie vont ensemble</h2>
        <p>
          Sur une réfection, la couverture est rarement le seul poste. Une fois
          les tuiles déposées, on voit l'état des chevrons et des pannes. Si le
          bois est attaqué ou affaissé, la reprise se traite dans la foulée,
          pendant que la toiture est ouverte, ce qui évite de réinstaller deux
          fois le chantier. C'est l'objet de la prestation <a
            href="/services/charpente">charpente et traitement du bois</a
          >.
        </p>
        <p>
          Même logique pour les évacuations. Refaire une couverture sans
          reprendre une gouttière percée ou une noue fatiguée n'a pas de sens :
          l'eau finira par repasser au même endroit. Les gouttières, chéneaux,
          noues et solins relèvent de la <a href="/services/zinguerie"
            >zinguerie</a
          >, et se traitent au mètre linéaire sur le même devis.
        </p>
        <p>
          Enfin, une couverture neuve se garde propre. Sur les pans nord et sous
          les arbres, la mousse revient au bout de quelques années. Un <a
            href="/services/nettoyage-toiture">démoussage avec hydrofuge</a
          > espace nettement les interventions et prolonge la durée de vie de la
          terre cuite.
        </p>
      </div>
    </div>
  </section>
</ServiceLayout>
