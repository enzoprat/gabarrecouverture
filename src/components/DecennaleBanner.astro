---
import Icon from "./Icon.astro";
import { BUSINESS } from "../site.config";
---

<aside class="bg-ink-950 text-white">
  <div class="container-site">
    <div
      class="flex flex-col items-start gap-3 py-5 md:flex-row md:items-center md:gap-4 md:py-6"
    >
      <span class="shrink-0 text-tuile-300" aria-hidden="true">
        <Icon name="shield" size={26} />
      </span>
      <p class="text-[15px] leading-[1.6] text-white/80 md:text-[16px]">
        Entreprise assurée en garantie décennale, <strong
          class="font-semibold text-white">{BUSINESS.insurance}</strong
        >. Attestation remise avec chaque devis.
      </p>
    </div>
  </div>
</aside>
