---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  id?: string;
  align?: "left" | "center";
  tone?: "light" | "dark";
}

const {
  eyebrow,
  title,
  intro,
  id,
  align = "left",
  tone = "light",
} = Astro.props;
---

<div
  class:list={[
    "max-w-3xl",
    align === "center" ? "mx-auto text-center" : "",
  ]}
>
  {eyebrow && <span class="eyebrow mb-3">{eyebrow}</span>}
  <h2
    id={id}
    class:list={["h2-site", tone === "dark" ? "text-white" : ""]}
  >
    {title}
  </h2>
  {
    intro && (
      <p
        class:list={[
          "mt-4 text-[17px] leading-[1.65]",
          tone === "dark" ? "text-white/70" : "text-ink-600",
        ]}
      >
        {intro}
      </p>
    )
  }
</div>
