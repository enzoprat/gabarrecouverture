---
import Icon from "./Icon.astro";

export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  schema?: boolean;
  class?: string;
}

const { items, schema = true, class: className = "" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<div class:list={["border-t border-line", className]}>
  {
    items.map((item) => (
      <details class="group border-b border-line">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-left">
          <span class="h3-site pr-2">{item.q}</span>
          <span
            class="mt-0.5 shrink-0 text-ink-400 transition-transform duration-150 group-open:rotate-180"
            aria-hidden="true"
          >
            <Icon name="chevron-down" size={20} />
          </span>
        </summary>
        <p class="max-w-3xl pb-5 text-ink-600">{item.a}</p>
      </details>
    ))
  }
</div>

{
  schema && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  )
}
