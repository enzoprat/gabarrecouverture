---
import { Image } from "astro:assets";
import type { Realisation } from "../data/realisations";

interface Props {
  item: Realisation;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;
---

<article class="overflow-hidden rounded-[10px] border border-line bg-white">
  <div class="grid grid-cols-2">
    <figure class="relative">
      <Image
        src={item.avant}
        alt={item.altAvant}
        widths={[320, 600]}
        sizes="(min-width: 1024px) 190px, (min-width: 640px) 45vw, 45vw"
        loading={eager ? "eager" : "lazy"}
        class="aspect-[4/3] w-full object-cover"
      />
      <figcaption
        class="absolute top-2.5 left-2.5 rounded-[6px] bg-ink-950/85 px-2 py-1 text-[11px] font-semibold tracking-[0.06em] text-white uppercase"
      >
        Avant
      </figcaption>
    </figure>
    <figure class="relative border-l border-white/20">
      <Image
        src={item.apres}
        alt={item.altApres}
        widths={[320, 600]}
        sizes="(min-width: 1024px) 190px, (min-width: 640px) 45vw, 45vw"
        loading={eager ? "eager" : "lazy"}
        class="aspect-[4/3] w-full object-cover"
      />
      <figcaption
        class="absolute top-2.5 left-2.5 rounded-[6px] bg-tuile-600 px-2 py-1 text-[11px] font-semibold tracking-[0.06em] text-white uppercase"
      >
        Après
      </figcaption>
    </figure>
  </div>

  <div class="border-t border-line p-5">
    <h3 class="h3-site">{item.prestation}</h3>
    <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-[14px] text-ink-600">
      <div class="flex gap-1.5">
        <dt class="text-ink-400">Commune</dt>
        <dd class="font-medium text-ink-800">{item.commune}</dd>
      </div>
      <div class="flex gap-1.5">
        <dt class="text-ink-400">Matériau</dt>
        <dd class="font-medium text-ink-800">{item.materiau}</dd>
      </div>
    </dl>
    <slot />
  </div>
</article>
