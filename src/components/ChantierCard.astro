---
import { Image } from "astro:assets";
import type { Realisation } from "../data/realisations";

interface Props {
  item: Realisation;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-[10px] border border-line bg-white"
>
  <Image
    src={item.image}
    alt={item.alt}
    widths={[400, 800]}
    sizes="(min-width: 1024px) 380px, (min-width: 768px) 45vw, 100vw"
    loading={eager ? "eager" : "lazy"}
    class="aspect-[3/2] w-full object-cover"
  />

  <div class="flex flex-1 flex-col border-t border-line p-5">
    <h3 class="h3-site">{item.prestation}</h3>
    <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-[14px] text-ink-600">
      <div class="flex gap-1.5">
        <dt class="text-ink-400">Commune</dt>
        <dd class="font-medium text-ink-800">{item.commune}</dd>
      </div>
      <div class="flex gap-1.5">
        <dt class="text-ink-400">Matériau</dt>
        <dd class="font-medium text-ink-800">{item.materiau}</dd>
      </div>
    </dl>
    <slot />
  </div>
</article>
