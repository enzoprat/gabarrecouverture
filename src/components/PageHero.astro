---
import Breadcrumb from "./Breadcrumb.astro";
import CallButton from "./CallButton.astro";
import type { Crumb } from "./Breadcrumb.astro";
import { BUSINESS, CTA_ARIA, CTA_REASSURANCE } from "../site.config";

interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  breadcrumb: Crumb[];
  showCta?: boolean;
}

const { eyebrow, title, lead, breadcrumb, showCta = true } = Astro.props;
---

<div class="border-b border-line bg-cream">
  <div class="container-site">
    <Breadcrumb items={breadcrumb} />
    <div class="max-w-3xl pt-4 pb-12 md:pt-6 md:pb-16">
      {eyebrow && <span class="eyebrow mb-4">{eyebrow}</span>}
      <h1 class="h1-site">{title}</h1>
      <p class="mt-5 text-[17px] leading-[1.65] text-ink-600 md:text-[19px]">
        {lead}
      </p>

      {
        showCta && (
          <div class="mt-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
              <CallButton size="lg" />
              <a
                href={BUSINESS.phoneHref}
                aria-label={CTA_ARIA}
                data-call-link
                class="hidden text-[26px] font-extrabold tracking-[-0.02em] text-ink-950 transition-colors duration-150 hover:text-tuile-600 sm:block"
              >
                {BUSINESS.phoneDisplay}
              </a>
            </div>
            <p class="mt-3 text-[14px] text-ink-400">{CTA_REASSURANCE}</p>
          </div>
        )
      }
    </div>
  </div>
</div>
