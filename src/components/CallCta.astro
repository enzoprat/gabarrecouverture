---
import CallButton from "./CallButton.astro";
import Icon from "./Icon.astro";
import { BUSINESS, CTA_ARIA, CTA_REASSURANCE } from "../site.config";

interface Props {
  title?: string;
  text?: string;
  tone?: "dark" | "cream";
}

const {
  title = "Une toiture à reprendre, une fuite à traiter",
  text = `Décrivez votre problème par téléphone. Si l'intervention le justifie, je passe voir la toiture sur place et vous remets un devis détaillé.`,
  tone = "dark",
} = Astro.props;

const dark = tone === "dark";
---

<section
  aria-labelledby="cta-final-title"
  class:list={[
    "py-16 md:py-24",
    dark ? "bg-ink-950 text-white" : "bg-cream border-y border-line",
  ]}
>
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <h2
        id="cta-final-title"
        class:list={["h2-site", dark ? "text-white" : ""]}
      >
        {title}
      </h2>
      <p
        class:list={[
          "mx-auto mt-4 max-w-xl text-[17px] leading-[1.65]",
          dark ? "text-white/70" : "text-ink-600",
        ]}
      >
        {text}
      </p>

      <a
        href={BUSINESS.phoneHref}
        aria-label={CTA_ARIA}
        data-call-link
        class:list={[
          "mt-8 block text-[34px] font-extrabold tracking-[-0.02em] transition-colors duration-150 md:text-[52px]",
          dark
            ? "text-white hover:text-tuile-300"
            : "text-ink-950 hover:text-tuile-600",
        ]}
      >
        {BUSINESS.phoneDisplay}
      </a>

      <div class="mt-6 flex justify-center">
        <CallButton size="lg" />
      </div>

      <p
        class:list={[
          "mt-3 text-[14px]",
          dark ? "text-white/55" : "text-ink-400",
        ]}
      >
        {CTA_REASSURANCE}
      </p>

      <p
        class:list={[
          "mt-6 inline-flex items-center gap-2 text-[14px]",
          dark ? "text-white/70" : "text-ink-600",
        ]}
      >
        <Icon name="clock" size={17} />
        <span>Horaires : {BUSINESS.openingHoursLabel}</span>
      </p>
    </div>
  </div>
</section>
