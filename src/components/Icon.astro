  alert:
    '<path d="M12 4.5 3 20h18L12 4.5Z"/><path d="M12 10v4.5"/><path d="M12 17.5h.01"/>',
  "map-pin":
    '<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
