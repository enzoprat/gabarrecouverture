  | "shield"
  | "check"
  | "arrow-right"
  | "chevron-down"
  | "chevron-right"
  | "menu"
  | "close"
  | "roof"
  | "gutter"
  | "beam"
  | "moss"
  | "leak"
  | "alert"
  | "map-pin"
  | "clock"
  | "mail"
  | "user"
  | "file-text"
  | "broom";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;

const paths: Record<IconName, string> = {
