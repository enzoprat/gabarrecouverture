---
import Icon from "./Icon.astro";
import { BUSINESS, COMMUNES, CTA_ARIA, SERVICES } from "../site.config";

const mainCommunes = COMMUNES.slice(0, 12);
const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-white">
  <div class="container-site py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div>
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-[8px] bg-white text-ink-950"
            aria-hidden="true"
          >
            <Icon name="roof" size={20} />
          </span>
          <span class="text-[17px] font-extrabold tracking-[-0.02em]"
            >Gabarre Couverture</span
          >
        </div>
        <p class="mt-4 text-[15px] leading-[1.65] text-white/60">
          Couvreur zingueur charpentier à {BUSINESS.city}. Réfection de toiture,
          zinguerie, charpente et démoussage en {BUSINESS.department}.
        </p>

        <ul class="mt-6 space-y-3 text-[15px]">
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 text-tuile-300"><Icon name="phone" size={17} /></span>
            <a
              href={BUSINESS.phoneHref}
              aria-label={CTA_ARIA}
              data-call-link
              class="font-bold transition-colors duration-150 hover:text-tuile-300"
              >{BUSINESS.phoneDisplay}</a
            >
          </li>
          <li class="flex items-start gap-2.5 text-white/60">
            <span class="mt-0.5 text-white/40"><Icon name="map-pin" size={17} /></span>
            <span>{BUSINESS.street}, {BUSINESS.postalCode} {BUSINESS.city}</span>
          </li>
          <li class="flex items-start gap-2.5 text-white/60">
            <span class="mt-0.5 text-white/40"><Icon name="clock" size={17} /></span>
            <span>{BUSINESS.openingHoursLabel}</span>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-white/50">
          Prestations
        </h2>
        <ul class="mt-4 space-y-2.5 text-[15px]">
          {
            SERVICES.map((service) => (
              <li>
                <a
                  href={service.href}
                  class="text-white/70 transition-colors duration-150 hover:text-white"
                >
                  {service.navLabel}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-white/50">
          Zone d'intervention
        </h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-[15px] lg:grid-cols-1 lg:gap-y-2">
          {
            mainCommunes.map((commune) => (
              <li>
                <a
                  href="/zone-intervention"
                  class="text-white/70 transition-colors duration-150 hover:text-white"
                >
                  {commune.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="/zone-intervention"
          class="mt-4 inline-flex items-center gap-1.5 text-[15px] font-medium text-tuile-300 transition-colors duration-150 hover:text-white"
        >
          Toutes les communes
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div>
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-white/50">
          Entreprise
        </h2>
        <ul class="mt-4 space-y-2.5 text-[15px]">
          <li>
            <a
              href="/entreprise"
              class="text-white/70 transition-colors duration-150 hover:text-white"
              >L'entreprise et les garanties</a
            >
          </li>
          <li>
            <a
              href="/realisations"
              class="text-white/70 transition-colors duration-150 hover:text-white"
              >Réalisations</a
            >
          </li>
          <li>
            <a
              href="/mentions-legales"
              class="text-white/70 transition-colors duration-150 hover:text-white"
              >Mentions légales</a
            >
          </li>
          <li>
            <a
              href="/politique-confidentialite"
              class="text-white/70 transition-colors duration-150 hover:text-white"
              >Politique de confidentialité</a
            >
          </li>
        </ul>

        <div class="mt-6 rounded-[10px] border border-white/10 p-4">
          <div class="flex items-center gap-2 text-[14px] font-semibold">
            <span class="text-tuile-300"><Icon name="shield" size={18} /></span>
            Garantie décennale
          </div>
          <p class="mt-1.5 text-[13px] leading-[1.6] text-white/55">
            {BUSINESS.insurance}. Attestation remise avec chaque devis.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="container-site flex flex-col gap-2 py-6 text-[13px] text-white/45 md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} Gabarre Couverture. SIRET {BUSINESS.siret}.</p>
      <p>Couvreur à {BUSINESS.city} et en {BUSINESS.department}.</p>
    </div>
  </div>
</footer>
