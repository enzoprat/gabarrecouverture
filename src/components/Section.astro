---
interface Props {
  id?: string;
  tone?: "white" | "cream" | "dark";
  class?: string;
  labelledby?: string;
}

const { id, tone = "white", class: className = "", labelledby } = Astro.props;

const tones: Record<string, string> = {
  white: "bg-white",
  cream: "bg-cream",
  dark: "bg-ink-950 text-white",
};
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={["py-16 md:py-24", tones[tone], className]}
>
  <div class="container-site">
    <slot />
  </div>
</section>
